# Static analysis needs the Magento classes on the autoloader, so this is only
# runnable where `composer install` has resolved magento/framework. The CI job
# that runs it is gated on those credentials being present rather than being
# allowed to pass vacuously.
parameters:
    level: 6
    # Registers the on-demand generator, so a Factory that only exists
    # after `setup:di:compile` resolves here too.
    bootstrapFiles:
        - Test/generated-classes.php
    paths:
        - Api
        - Controller
        - Model
        - Observer
        - Plugin
        - ViewModel
    excludePaths:
        - Test/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # setIsSuperMode() really is a magic setter: Product stores it through
        # DataObject rather than declaring it.
        -
            message: '#Call to an undefined method Magento\\Catalog\\Model\\Product::setIsSuperMode\(\)#'
            path: Observer/ApplyEmbroideryPrice.php
            # The framework's docblock varies across the versions this package supports.
            reportUnmatched: false
        # __() returns a Phrase, and Magento's own importers hand one straight
        # to this API; the parameter is documented as string and never was.
        -
            message: '#of method Magento\\ImportExport\\Model\\Import\\Entity\\AbstractEntity::addMessageTemplate\(\) expects string, Magento\\Framework\\Phrase given#'
            # The framework's docblock varies across the versions this package supports.
            reportUnmatched: false
